# Server runtime integrations. Keep real values in the hosting secret store.
APP_ENV=development
ALLOW_DEMO_AUTH=true
SEED_DEMO_DATA=true
ADMIN_EMAILS=founder@example.com
PRACTITIONER_EMAILS=
BACKUP_RUN_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OPEN_WEARABLES_URL=
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_WEBHOOK_SECRET=

# Simplest activation: set OPENAI_API_KEY. The app calls the Responses API directly.
OPENAI_API_KEY=
AI_PRIMARY_MODEL=gpt-5.6
AI_FAST_MODEL=gpt-5.6
AI_VISION_MODEL=gpt-5.6
AI_TIMEOUT_MS=30000
AI_REASONING_EFFORT=medium

# Recommended production routing: a full Responses-compatible endpoint, such as
# https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openai/responses
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# Optional second Responses-compatible endpoint, used only after primary retries.
AI_FALLBACK_URL=
AI_FALLBACK_TOKEN=
AI_FALLBACK_MODEL=

LAB_ADAPTER_URL=
LAB_ADAPTER_API_KEY=
LAB_ADAPTER_WEBHOOK_SECRET=

# Optional future ABDM exchange registration.
ABDM_GATEWAY_URL=
ABDM_CLIENT_ID=
